{
  "$defs": {
    "AcaoExcecao": {
      "enum": [
        "nao_gerar_minuta",
        "escalar_socio",
        "sinalizar_acordo",
        "pedir_subsidio",
        "alertar_revisor",
        "gerar_minuta_sem_merito",
        "escalar_advogado_carteira"
      ],
      "title": "AcaoExcecao",
      "type": "string"
    },
    "Alcada": {
      "additionalProperties": false,
      "description": "Alçada por valor. Superada pelo `fluxo_aprovacao` (decisão de 2026-10-19); mantida\npara playbooks antigos.",
      "properties": {
        "ate_valor": {
          "minimum": 0,
          "title": "Ate Valor",
          "type": "number"
        },
        "aprovador": {
          "title": "Aprovador",
          "type": "string"
        }
      },
      "required": [
        "ate_valor",
        "aprovador"
      ],
      "title": "Alcada",
      "type": "object"
    },
    "Antifraude": {
      "additionalProperties": false,
      "properties": {
        "regra_inviolavel": {
          "default": "Nenhuma checagem produz rótulo de 'fraudador'; só flags com evidência. Apenas decisão humana registrada com OAB (human_decide) confirma um flag.",
          "title": "Regra Inviolavel",
          "type": "string"
        },
        "checagens": {
          "items": {
            "$ref": "#/$defs/ChecagemAntifraude"
          },
          "minItems": 1,
          "title": "Checagens",
          "type": "array"
        }
      },
      "required": [
        "checagens"
      ],
      "title": "Antifraude",
      "type": "object"
    },
    "AssuntoCnj": {
      "additionalProperties": false,
      "properties": {
        "codigo": {
          "pattern": "^\\d{1,6}$",
          "title": "Codigo",
          "type": "string"
        },
        "nome": {
          "title": "Nome",
          "type": "string"
        },
        "conferido": {
          "default": false,
          "title": "Conferido",
          "type": "boolean"
        }
      },
      "required": [
        "codigo",
        "nome"
      ],
      "title": "AssuntoCnj",
      "type": "object"
    },
    "AutorizacaoDupla": {
      "additionalProperties": false,
      "description": "Dupla autorização por escrito (sócio FBS + jurídico do cliente) para atos sensíveis.",
      "properties": {
        "exigida_para": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Exigida Para",
          "type": "array"
        },
        "autorizadores": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Autorizadores",
          "type": "array"
        },
        "registro": {
          "description": "como/onde a plataforma guarda o registro (trilha de auditoria)",
          "title": "Registro",
          "type": "string"
        }
      },
      "required": [
        "exigida_para",
        "autorizadores",
        "registro"
      ],
      "title": "AutorizacaoDupla",
      "type": "object"
    },
    "CampoDossie": {
      "additionalProperties": false,
      "properties": {
        "campo": {
          "pattern": "^[a-z][a-z0-9_.]{1,80}$",
          "title": "Campo",
          "type": "string"
        },
        "tipo": {
          "$ref": "#/$defs/TipoCampo"
        },
        "origem": {
          "$ref": "#/$defs/OrigemCampo"
        },
        "descricao": {
          "title": "Descricao",
          "type": "string"
        },
        "obrigatorio": {
          "default": true,
          "title": "Obrigatorio",
          "type": "boolean"
        },
        "bloqueia_minuta_se_ausente": {
          "default": false,
          "title": "Bloqueia Minuta Se Ausente",
          "type": "boolean"
        },
        "disponibilidade": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ex.: 'a confirmar com cliente' — se o cliente consegue entregar",
          "title": "Disponibilidade"
        }
      },
      "required": [
        "campo",
        "tipo",
        "origem",
        "descricao"
      ],
      "title": "CampoDossie",
      "type": "object"
    },
    "CategoriaTese": {
      "enum": [
        "preliminar",
        "prejudicial",
        "merito",
        "subsidiaria",
        "processual",
        "sinal"
      ],
      "title": "CategoriaTese",
      "type": "string"
    },
    "ChecagemAntifraude": {
      "additionalProperties": false,
      "properties": {
        "codigo": {
          "description": "fraud_checks.check_code (M4)",
          "pattern": "^[a-z][a-z0-9_]{2,60}$",
          "title": "Codigo",
          "type": "string"
        },
        "descricao": {
          "title": "Descricao",
          "type": "string"
        },
        "parametros": {
          "additionalProperties": true,
          "title": "Parametros",
          "type": "object"
        },
        "severidade": {
          "$ref": "#/$defs/Severidade",
          "default": "medium"
        },
        "evidencia_esperada": {
          "title": "Evidencia Esperada",
          "type": "string"
        },
        "implementada_em_m4": {
          "default": false,
          "title": "Implementada Em M4",
          "type": "boolean"
        },
        "calibrar": {
          "default": true,
          "title": "Calibrar",
          "type": "boolean"
        }
      },
      "required": [
        "codigo",
        "descricao",
        "evidencia_esperada"
      ],
      "title": "ChecagemAntifraude",
      "type": "object"
    },
    "Condicao": {
      "additionalProperties": false,
      "properties": {
        "campo": {
          "title": "Campo",
          "type": "string"
        },
        "operador": {
          "$ref": "#/$defs/Operador"
        },
        "valor": {
          "default": null,
          "title": "Valor"
        },
        "nota": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nota"
        }
      },
      "required": [
        "campo",
        "operador"
      ],
      "title": "Condicao",
      "type": "object"
    },
    "CriteriosRevisao": {
      "additionalProperties": false,
      "properties": {
        "tempo_minimo_segundos": {
          "description": "REVIEW_MIN_SECONDS_<tipo> (M7)",
          "minimum": 60,
          "title": "Tempo Minimo Segundos",
          "type": "integer"
        },
        "papel_minimo_revisor": {
          "default": "lawyer",
          "enum": [
            "lawyer",
            "partner"
          ],
          "title": "Papel Minimo Revisor",
          "type": "string"
        },
        "revisor_final": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "quem assina a revisão final (ex.: advogado OAB da carteira)",
          "title": "Revisor Final"
        },
        "exige_segunda_revisao_se": {
          "items": {
            "$ref": "#/$defs/Condicao"
          },
          "title": "Exige Segunda Revisao Se",
          "type": "array"
        },
        "exige_segunda_revisao_tambem": {
          "description": "situações que exigem sócio mas não são expressas por campo do dossiê",
          "items": {
            "type": "string"
          },
          "title": "Exige Segunda Revisao Tambem",
          "type": "array"
        },
        "autorizacao_dupla": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutorizacaoDupla"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checklist": {
          "items": {
            "$ref": "#/$defs/ItemChecklist"
          },
          "minItems": 3,
          "title": "Checklist",
          "type": "array"
        },
        "motivos_recusa_padrao": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Motivos Recusa Padrao",
          "type": "array"
        },
        "observacoes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observacoes"
        }
      },
      "required": [
        "tempo_minimo_segundos",
        "checklist",
        "motivos_recusa_padrao"
      ],
      "title": "CriteriosRevisao",
      "type": "object"
    },
    "Excecao": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^X[0-9]{2}$",
          "title": "Id",
          "type": "string"
        },
        "descricao": {
          "title": "Descricao",
          "type": "string"
        },
        "condicoes": {
          "items": {
            "$ref": "#/$defs/Condicao"
          },
          "minItems": 1,
          "title": "Condicoes",
          "type": "array"
        },
        "acao": {
          "$ref": "#/$defs/AcaoExcecao"
        },
        "acoes_paralelas": {
          "description": "ações executadas em paralelo à `acao` (ou após o prazo, se `acao` é pedir_subsidio)",
          "items": {
            "$ref": "#/$defs/AcaoExcecao"
          },
          "title": "Acoes Paralelas",
          "type": "array"
        },
        "nota": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nota"
        }
      },
      "required": [
        "id",
        "descricao",
        "condicoes",
        "acao"
      ],
      "title": "Excecao",
      "type": "object"
    },
    "FaixaAcordo": {
      "additionalProperties": false,
      "properties": {
        "grupo_comarcas": {
          "title": "Grupo Comarcas",
          "type": "string"
        },
        "comarcas": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Comarcas",
          "type": "array"
        },
        "valor_min": {
          "minimum": 0,
          "title": "Valor Min",
          "type": "number"
        },
        "valor_max": {
          "minimum": 0,
          "title": "Valor Max",
          "type": "number"
        },
        "moeda": {
          "const": "BRL",
          "default": "BRL",
          "title": "Moeda",
          "type": "string"
        },
        "base": {
          "description": "como a faixa foi obtida (ex.: média de condenação na carteira)",
          "title": "Base",
          "type": "string"
        },
        "calibrar": {
          "default": true,
          "title": "Calibrar",
          "type": "boolean"
        },
        "provisorio": {
          "default": false,
          "description": "faixa ilustrativa, ainda sem dados",
          "title": "Provisorio",
          "type": "boolean"
        },
        "recalibrar_em_dias": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recalibrar Em Dias"
        }
      },
      "required": [
        "grupo_comarcas",
        "comarcas",
        "valor_min",
        "valor_max",
        "base"
      ],
      "title": "FaixaAcordo",
      "type": "object"
    },
    "FluxoAprovacao": {
      "additionalProperties": false,
      "description": "Toda proposta de acordo: a FBS recomenda (valor sugerido + faixa), o cliente aprova.",
      "properties": {
        "recomendacao": {
          "title": "Recomendacao",
          "type": "string"
        },
        "aprovacao": {
          "title": "Aprovacao",
          "type": "string"
        },
        "registro": {
          "title": "Registro",
          "type": "string"
        }
      },
      "required": [
        "recomendacao",
        "aprovacao",
        "registro"
      ],
      "title": "FluxoAprovacao",
      "type": "object"
    },
    "Fundamentacao": {
      "additionalProperties": false,
      "properties": {
        "dispositivos": {
          "items": {
            "$ref": "#/$defs/ReferenciaLegal"
          },
          "title": "Dispositivos",
          "type": "array"
        },
        "precedentes": {
          "items": {
            "$ref": "#/$defs/ReferenciaLegal"
          },
          "title": "Precedentes",
          "type": "array"
        },
        "argumentos_chave": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Argumentos Chave",
          "type": "array"
        }
      },
      "required": [
        "argumentos_chave"
      ],
      "title": "Fundamentacao",
      "type": "object"
    },
    "GatilhosClassificacao": {
      "additionalProperties": false,
      "description": "Como M1/M9 reconhecem que um processo pertence a esta tipologia.",
      "properties": {
        "assuntos_cnj": {
          "items": {
            "$ref": "#/$defs/AssuntoCnj"
          },
          "minItems": 1,
          "title": "Assuntos Cnj",
          "type": "array"
        },
        "classes_cnj": {
          "items": {
            "$ref": "#/$defs/AssuntoCnj"
          },
          "title": "Classes Cnj",
          "type": "array"
        },
        "palavras_chave": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Palavras Chave",
          "type": "array"
        },
        "palavras_que_excluem": {
          "items": {
            "type": "string"
          },
          "title": "Palavras Que Excluem",
          "type": "array"
        },
        "confianca_minima": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Confianca Minima",
          "type": "number"
        }
      },
      "required": [
        "assuntos_cnj",
        "palavras_chave"
      ],
      "title": "GatilhosClassificacao",
      "type": "object"
    },
    "ItemChecklist": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^R[0-9]{2}$",
          "title": "Id",
          "type": "string"
        },
        "item": {
          "title": "Item",
          "type": "string"
        },
        "bloqueante": {
          "default": true,
          "title": "Bloqueante",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "item"
      ],
      "title": "ItemChecklist",
      "type": "object"
    },
    "Lado": {
      "enum": [
        "defesa",
        "autor"
      ],
      "title": "Lado",
      "type": "string"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "slug único do playbook",
          "pattern": "^[a-z0-9][a-z0-9-]{2,79}$",
          "title": "Id",
          "type": "string"
        },
        "nome": {
          "title": "Nome",
          "type": "string"
        },
        "tipologia": {
          "description": "valor gravado em cases.typology / theses.typology",
          "pattern": "^[a-z0-9_]{3,60}$",
          "title": "Tipologia",
          "type": "string"
        },
        "tribunal": {
          "description": "TJPA, TRT8…",
          "pattern": "^[A-Z]{2,6}[0-9]{0,2}$",
          "title": "Tribunal",
          "type": "string"
        },
        "reu_tipo": {
          "description": "ex.: instituicao_financeira_regional (no polo ativo: tipo do executado, ex.: devedor_pf_pj_credito_bancario)",
          "title": "Reu Tipo",
          "type": "string"
        },
        "lado": {
          "$ref": "#/$defs/Lado",
          "default": "defesa"
        },
        "polo": {
          "$ref": "#/$defs/Polo",
          "default": "passivo",
          "description": "posição processual do cliente: passivo (réu/executado, padrão) | ativo (autor/exequente — ex.: execução de crédito bancário)"
        },
        "tipo_peca_padrao": {
          "default": "contestacao",
          "description": "drafts.draft_type",
          "title": "Tipo Peca Padrao",
          "type": "string"
        },
        "versao": {
          "minimum": 1,
          "title": "Versao",
          "type": "integer"
        },
        "supera_versao": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supera Versao"
        },
        "autor_nome": {
          "title": "Autor Nome",
          "type": "string"
        },
        "autor_oab": {
          "description": "formato 'PA 12724'",
          "pattern": "^[A-Z]{2}\\s?\\d{1,6}[A-Z]?$",
          "title": "Autor Oab",
          "type": "string"
        },
        "criado_em": {
          "format": "date-time",
          "title": "Criado Em",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PlaybookStatus",
          "default": "rascunho"
        },
        "aprovado_por_nome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aprovado Por Nome"
        },
        "aprovado_por_oab": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}\\s?\\d{1,6}[A-Z]?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aprovado Por Oab"
        },
        "aprovado_em": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aprovado Em"
        },
        "descricao": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Descricao"
        },
        "observacoes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observacoes"
        },
        "revisoes": {
          "description": "sessões de revisão já realizadas (cronológico)",
          "items": {
            "$ref": "#/$defs/Revisao"
          },
          "title": "Revisoes",
          "type": "array"
        },
        "piloto": {
          "anyOf": [
            {
              "$ref": "#/$defs/Piloto"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "nome",
        "tipologia",
        "tribunal",
        "reu_tipo",
        "versao",
        "autor_nome",
        "autor_oab",
        "criado_em"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "Metrica": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^M[0-9]{2}$",
          "title": "Id",
          "type": "string"
        },
        "nome": {
          "title": "Nome",
          "type": "string"
        },
        "definicao": {
          "title": "Definicao",
          "type": "string"
        },
        "meta": {
          "title": "Meta",
          "type": "string"
        },
        "fonte": {
          "title": "Fonte",
          "type": "string"
        }
      },
      "required": [
        "id",
        "nome",
        "definicao",
        "meta",
        "fonte"
      ],
      "title": "Metrica",
      "type": "object"
    },
    "ModeloPeca": {
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "default": "contestacao",
          "title": "Tipo",
          "type": "string"
        },
        "formato_saida": {
          "default": "markdown",
          "enum": [
            "markdown",
            "docx"
          ],
          "title": "Formato Saida",
          "type": "string"
        },
        "regra_citacao": {
          "default": "Toda afirmação de fato cita document_page_id (draft_citations). Sem página, sem afirmação.",
          "title": "Regra Citacao",
          "type": "string"
        },
        "secoes": {
          "items": {
            "$ref": "#/$defs/SecaoPeca"
          },
          "minItems": 3,
          "title": "Secoes",
          "type": "array"
        },
        "estilo": {
          "items": {
            "type": "string"
          },
          "title": "Estilo",
          "type": "array"
        }
      },
      "required": [
        "secoes"
      ],
      "title": "ModeloPeca",
      "type": "object"
    },
    "NivelProvidencia": {
      "additionalProperties": false,
      "description": "Escalada de providências de uma tese do tipo `sinal` (ex.: litigância predatória).",
      "properties": {
        "nivel": {
          "enum": [
            "a",
            "b",
            "c"
          ],
          "title": "Nivel",
          "type": "string"
        },
        "descricao": {
          "title": "Descricao",
          "type": "string"
        },
        "autorizacao_dupla": {
          "default": false,
          "description": "exige autorização por escrito de sócio FBS + jurídico do cliente, registrada na plataforma",
          "title": "Autorizacao Dupla",
          "type": "boolean"
        }
      },
      "required": [
        "nivel",
        "descricao"
      ],
      "title": "NivelProvidencia",
      "type": "object"
    },
    "Operador": {
      "description": "Operadores das condições de aplicação, avaliados sobre campos do dossiê (M5).",
      "enum": [
        "==",
        "!=",
        ">",
        ">=",
        "<",
        "<=",
        "in",
        "not_in",
        "existe",
        "nao_existe",
        "contem",
        "nao_contem"
      ],
      "title": "Operador",
      "type": "string"
    },
    "OrigemCampo": {
      "enum": [
        "extracao",
        "subsidio",
        "publicacao",
        "antifraude",
        "calculado"
