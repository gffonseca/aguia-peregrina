{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": { "nixPkgs": ["python312", "gcc"] },
        "install": { "cmds": ["pip install --upgrade pip", "pip install -e \".[llm,workflows]\""] }
      }
    }
  },
  "deploy": {
    "startCommand": "python -m app.workflows.worker",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
