# --- Aplicação ---
APP_ENV=dev
APP_NAME=aguia-peregrina
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
LOG_LEVEL=INFO

# --- Banco (Postgres + pgvector). Em testes locais pode ser sqlite:///./dev.db ---
DATABASE_URL=postgresql+psycopg://aguia:aguia@localhost:5432/aguia
# Role sem BYPASSRLS usada pela aplicação (as policies de RLS só valem para ela)
DB_APP_ROLE=aguia_app

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Workflows ---
# in_process | hatchet
WORKFLOW_ENGINE=in_process
HATCHET_CLIENT_TOKEN=

# --- LLM gateway (LiteLLM) ---
LITELLM_CONFIG=litellm_config.yaml
LLM_DEFAULT_MODEL=claude-sonnet
LLM_SMALL_MODEL=claude-haiku
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Se usar o proxy LiteLLM em vez do SDK embutido:
LITELLM_PROXY_URL=
LITELLM_PROXY_KEY=

# --- Revisão (M7) ---
# tempo mínimo de revisão por tipo de peça, em segundos
REVIEW_MIN_SECONDS_DEFAULT=600
REVIEW_MIN_SECONDS_CONTESTACAO=900

# --- Integrações ---
PUBLICATIONS_PROVIDER=comunica_pje   # comunica_pje | solucionare
SOLUCIONARE_API_KEY=
DATAJUD_API_KEY=

# --- Storage (S3-compatível / Railway bucket) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
